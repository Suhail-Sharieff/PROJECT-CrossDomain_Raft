        <mxCell id="E-inRg7IrZQUGey8yJ1z-59" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontStyle=0" value="apply to State Machine&lt;div&gt;Entry Commited&lt;/div&gt;" vertex="1">
